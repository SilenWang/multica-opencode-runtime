# for multica login
MULTICA_SERVER_URL=https://multica.ai
MULTICA_TOKEN=YOU_TOKEN

# runtime container name(for restart)
CONTAINER_NAME=YOU_CONTAINER_NAME_FOR_RUNTIME

# host docker group gid (so the container's ubuntu user can access /var/run/docker.sock)
# get it on the host with: stat -c %g /var/run/docker.sock
DOCKER_HOST_GID=999

# API tokens for opencode providers
DEEPSEEK_TOKEN=YOU_DEEPSEEK_TOKEN
OPENCODE_GO_TOKEN=YOU_OPENCODE_GO_TOKEN

# Claude Code provider selection (deepseek or opencode-go)
CLAUDE_PROVIDER=deepseek

# OpenCode Go base URL (Anthropic-compatible endpoint, only used when CLAUDE_PROVIDER=opencode-go)
OPENCODE_GO_BASE_URL=https://api.opencode-go.com

# Optional: Claude Code model overrides (defaults are for DeepSeek)
# CLAUDE_OPUS_MODEL=deepseek-v4-pro[1m]
# CLAUDE_SONNET_MODEL=deepseek-v4-pro[1m]
# CLAUDE_HAIKU_MODEL=deepseek-v4-flash
# CLAUDE_SUBAGENT_MODEL=deepseek-v4-flash

# --- Codex CLI (Official DeepSeek Integration) ---
# DEEPSEEK_TOKEN is used by the official DeepSeek Codex integration (config.toml + models.json).
# Codex reads ~/.codex/config.toml and ~/.codex/models.json at startup.
# The config uses "responses" wire_api to communicate directly with DeepSeek API.
# No bridge needed — official integration uses Codex native provider config.

# --- CodeBuddy CLI ---
# CodeBuddy models.json is auto-generated with three models:
#   - deepseek-v4-pro (DeepSeek API)
#   - deepseek-v4-flash (DeepSeek API)
#   - opencode-go (OpenCode Go API)
# Uses DEEPSEEK_TOKEN and OPENCODE_GO_TOKEN from above.

# --- Reasonix CLI ---
# Reasonix uses DEEPSEEK_TOKEN from above to connect directly to the
# DeepSeek official API. On container start, entrypoint writes
# ~/.reasonix/.env (DEEPSEEK_API_KEY) and ~/.reasonix/config.toml
# (provider `deepseek`, models deepseek-v4-flash / deepseek-v4-pro).
# In a project dir, just run `reasonix` (or `reasonix run "<task>"`) to start.

# Optional: Reasonix default model override (defaults to deepseek/deepseek-v4-flash)
# REASONIX_DEFAULT_MODEL=deepseek/deepseek-v4-flash
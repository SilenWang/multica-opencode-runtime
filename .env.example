# for multica login
MULTICA_SERVER_URL=https://multica.ai
MULTICA_TOKEN=YOU_TOKEN

# runtime container name(for restart)
CONTAINER_NAME=YOU_CONTAINER_NAME_FOR_RUNTIME

# host docker group gid (so the container's ubuntu user can access /var/run/docker.sock)
# get it on the host with: stat -c %g /var/run/docker.sock
DOCKER_HOST_GID=999

# --- GitHub CLI (optional) ---
# 可选：设置后在容器启动时自动非交互登录 gh（等价于 gh auth login --with-token）。
# 不设置也没关系：未登录不会阻塞或关闭容器，进入容器后手动执行 `BROWSER=false gh auth login` 即可
# （容器内有 Chrome，带 BROWSER=false 才会把设备验证码打印出来，方便在日志/终端里复制）。
# GH_TOKEN=ghp_xxx

# API tokens for opencode providers
DEEPSEEK_TOKEN=YOU_DEEPSEEK_TOKEN

# New-API gateway (Codex default upstream; also added to opencode / Reasonix)
NEW_API_TOKEN=YOU_NEW_API_TOKEN
NEW_API_BASE_URL=http://192.168.8.228:3000

# --- Codex CLI (default: New-API, fallback: official DeepSeek) ---
# NEW_API_TOKEN is used first: Codex connects to the New-API gateway
# (~/.codex/config.toml + models.json, wire_api = "responses").
# If NEW_API_TOKEN is not set, Codex falls back to the official DeepSeek
# integration using DEEPSEEK_TOKEN directly.
# New-API always goes through the CLIProxyAPI bridge below; DeepSeek official
# probes /v1/responses and only bridges when the endpoint is clearly unsupported.

# --- CLIProxyAPI bridge (Codex 协议转换) ---
# Codex CLI 只会说 OpenAI 的 responses 协议；若上游网关（如 new-api）只提供
# /v1/chat/completions，直连会失败。容器启动时会拉起 CLIProxyAPI 监听
# 127.0.0.1:8317，把 Codex 的 responses 请求翻译成 chat/completions 再转发上游。
# 参考 https://help.router-for.me/introduction/quick-start.html
#
# CLIPROXY_BRIDGE: auto(默认) / on / off
#   auto —— 上游为 newapi 时始终启用桥接（new-api 的 responses 流式支持不完整，
#           非流式探测可能返回 200 但 Codex 流式请求会中途断开，故不做跳过判断）；
#           其它上游（如 DeepSeek 官方）探测 POST /v1/responses，返回 404/405/501/400
#           （明确不支持）时启用桥接，其余情况保持既有直连行为。
#   on   —— 无条件启用；off —— 禁用桥接。
# CLIPROXY_BRIDGE=auto
# CLIPROXY_PORT=8317
# CLIPROXY_HOME=/home/ubuntu/.cli-proxy-api
# 桥接自身的访问 key（不给定时自动生成并持久化在 $CLIPROXY_HOME/api_key）
# CLIPROXY_API_KEY=sk-...
# 转发给上游的模型映射，格式 "上游模型名:Codex侧名字"，逗号分隔；别名省略时两边同名。
# 默认沿用 Codex 直连该上游时的模型集（new-api: deepseek-v4-flash,qwen3.8-flash；
# deepseek 官方: deepseek-v4-flash）
# CLIPROXY_MODELS="deepseek-chat:deepseek-v4-flash"

# --- Reasonix CLI ---
# Reasonix connects to the DeepSeek official API and the New-API gateway.
# On container start, entrypoint writes ~/.reasonix/.env (DEEPSEEK_API_KEY,
# NEW_API_KEY) and ~/.reasonix/config.toml with two providers:
#   - deepseek (official DeepSeek, models deepseek-v4-flash)
#   - newapi (New-API gateway, models deepseek-v4-flash / qwen3.8-flash)
# Switch provider with `reasonix run --model deepseek "<task>"` or
# `reasonix run --model newapi "<task>"`.
# In a project dir, just run `reasonix` (or `reasonix run "<task>"`) to start.

# Optional: Reasonix default model override (defaults to deepseek/deepseek-v4-flash)
# REASONIX_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# --- ponytail (lazy senior dev 规则集，仅 Codex，默认不开启) ---
# 容器内只有 Codex 安装了 ponytail 插件，默认级别为 off（不注入规则）。
# 需要时在命令行临时开启（不改容器默认）：PONYTAIL_DEFAULT_MODE=full codex
# 级别取值：lite / full / ultra / off。会话内也可用 `@ponytail`（skills）切换。
# 如需把容器默认级别改成开启，在 .env 里设置下面的变量（会覆盖 config.json）。
# PONYTAIL_DEFAULT_MODE=full
# --- 浏览器（ego-browser / ego-lite-linux + Google Chrome，headed + Xvfb） ---
# 容器内可用 `ego-browser nodejs <<'EOF' … EOF` 驱动共享 Chrome。
# 容器没有真实显示器，entrypoint 启动时会拉起 Xvfb（DISPLAY=:99），Chrome 以 headed
# 模式运行：UA/语言/渲染都是真实浏览器的，不需要给上游 ego-lite-linux 打补丁。
#   XVFB_SCREEN=1920x1080x24   虚拟屏幕尺寸与色深
#   EGO_HEADLESS=1             显式降级为无头（不需要 Xvfb，但 UA 会带 HeadlessChrome）
# LANG / LANGUAGE / TZ 由镜像设置（zh_CN.UTF-8 / zh_CN:zh / Asia/Shanghai），
# 需要别的语言或时区再在这里覆盖。Xvfb 日志：容器内 /tmp/xvfb.log。
# XVFB_SCREEN=1920x1080x24
# EGO_HEADLESS=1
